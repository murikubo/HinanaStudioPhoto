{
  "name": "hinana-studio-photo",
  "version": "1.0.0-alpha.1",
  "private": true,
  "description": "HINANA STUDIO PHOTO desktop image editor",
  "author": "Hinana Studio",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist-electron/main.js",
  "build": {
    "appId": "studio.hinana.photo",
    "productName": "HINANA STUDIO PHOTO",
    "copyright": "Copyright © 2026 Hinana Studio",
    "directories": {
      "output": "release"
    },
    "icon": "photoicon.png",
    "extraResources": [
      {
        "from": "photoicon.png",
        "to": "photoicon.png"
      }
    ],
    "fileAssociations": [
      {
        "ext": "hinanaphoto",
        "name": "HINANA STUDIO PHOTO Project",
        "description": "Portable HINANA STUDIO PHOTO project",
        "icon": "photoicon.png",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "photoicon.png",
      "artifactName": "HINANA-STUDIO-PHOTO-${version}-${arch}-Setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        },
        {
          "target": "zip",
          "arch": ["arm64", "x64"]
        }
      ],
      "icon": "photoicon.png",
      "category": "public.app-category.photography",
      "artifactName": "HINANA-STUDIO-PHOTO-${version}-${arch}.${ext}"
    },
    "dmg": {
      "license": "LICENSE.rtf"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HINANA STUDIO PHOTO",
      "license": "LICENSE.rtf"
    }
  },
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on http://localhost:5173 && node scripts/launch-electron.cjs\"",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "npm run license:rtf && tsc && vite build && npm run build:electron",
    "preview": "vite preview",
    "start": "node scripts/launch-electron.cjs",
    "license:rtf": "node scripts/generate-license-rtf.cjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --x64 --arm64"
  },
  "dependencies": {
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "^26.0.12",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  }
}
